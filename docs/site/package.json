    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.0",
    "fumadocs-core": "16.14.2",
    "fumadocs-ui": "16.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "takumi-js": "2.5.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
