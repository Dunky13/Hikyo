---
import { Icon } from '@astrojs/starlight/components';
---

<starlight-theme-select>
	<label>
		<span class="sr-only">{Astro.locals.t('themeSelect.accessibleLabel')}</span>
		<Icon name="moon" class="label-icon" />
		<select autocomplete="off">
			<option value="dark" selected>{Astro.locals.t('themeSelect.dark')}</option>
			<option value="light">{Astro.locals.t('themeSelect.light')}</option>
		</select>
		<Icon name="down-caret" class="caret" />
	</label>
</starlight-theme-select>

<style>
	@layer starlight.core {
		label {
			position: relative;
			display: flex;
			min-height: 44px;
			align-items: center;
			color: var(--sl-color-gray-2);
		}

		label:hover {
			color: var(--sl-color-white);
		}

		:global(svg) {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			pointer-events: none;
		}

		select {
			width: 7.25rem;
			min-height: 44px;
			padding-inline: 1.625rem 2rem;
			border: 0;
			background: transparent;
			color: inherit;
			cursor: pointer;
			appearance: none;
		}

		option {
			background-color: var(--sl-color-bg-nav);
			color: var(--sl-color-gray-1);
		}

		.label-icon {
			inset-inline-start: 0.5rem;
			font-size: 0.875rem;
		}

		.caret {
			inset-inline-end: 0.5rem;
			font-size: 1.25rem;
		}
	}
</style>

<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'dark' | 'light';
	type ThemeProvider = { updatePickers(theme?: string): void };
	const storageKey = 'starlight-theme';
	const themeProvider = (window as unknown as Window & { StarlightThemeProvider: ThemeProvider })
		.StarlightThemeProvider;

	function loadTheme(): Theme {
		const stored = typeof localStorage !== 'undefined' && localStorage.getItem(storageKey);
		if (stored === 'light') return 'light';
		return 'dark';
	}

	function onThemeChange(theme: Theme): void {
		themeProvider.updatePickers(theme);
		document.documentElement.dataset.theme = theme;
		localStorage.setItem(storageKey, theme);
	}

	class HikyoThemeSelect extends HTMLElement {
		constructor() {
			super();
			onThemeChange(loadTheme());
			this.querySelector('select')?.addEventListener('change', (event) => {
				const select = event.currentTarget;
				if (select instanceof HTMLSelectElement) {
					onThemeChange(select.value === 'light' ? 'light' : 'dark');
				}
			});
		}
	}

	customElements.define('starlight-theme-select', HikyoThemeSelect);
</script>
